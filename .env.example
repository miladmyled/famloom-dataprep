# famloom-dataprep configuration. Copy to .env (git-ignored) and fill in values.
# NEVER commit real values. Production values live in the Kubernetes Secret `dataprep-secrets`.

# --- Database (dev: x3db_dev; the scripts refuse the production database) -------------------
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# --- Kafka (producer and consumer use the same topic variable) --------------------------------
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=raw-events-ingestion
KAFKA_CLIENT_ID=
KAFKA_CONSUMER_GROUP_ID=
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_POLL_TIMEOUT_SECONDS=1.0
# Optional SASL: KAFKA_SECURITY_PROTOCOL, KAFKA_SASL_MECHANISMS, KAFKA_SASL_USERNAME, KAFKA_SASL_PASSWORD

# --- Eventbrite / Meetup ------------------------------------------------------------------------
EVENTBRITE_API_TOKEN=
EVENTBRITE_API_URL=https://www.eventbriteapi.com/v3
EVENTBRITE_MAX_PAGES=10
EVENTBRITE_TIMEOUT_SECONDS=10

# --- Classification (Jev primary, Gemini fallback) ---------------------------------------------
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CLASSIFIER_PROVIDER=jev
CLASSIFIER_FALLBACK=gemini
CLASSIFIER_MAX_CONCURRENCY=4
GEMINI_BATCH_SIZE=20
# Thresholds approved at GATE 1a
FAMILY_ACCEPT_THRESHOLD=0.50
FAMILY_REVIEW_THRESHOLD=0.40
TAG_THRESHOLD=0.70
LANGUAGE_THRESHOLD=0.60
SINGLES_REJECT_THRESHOLD=0.60
# ADULT_REJECT_THRESHOLD=1.01   (adult content does not reject; set e.g. 0.60 to reject it)
REVIEW_POLICY=drop

# --- Web sources ------------------------------------------------------------------------------
CRAWLER_CONTACT_EMAIL=
BRAVE_SEARCH_API_KEY=
BRAVE_MAX_QUERIES_PER_RUN=60
WEB_MAX_PAGES_PER_RUN=150
WEB_APPROVAL_THRESHOLD=0.75
CURATED_CALENDARS_ENABLED=true
WEB_SEARCH_ENABLED=true
FACEBOOK_SNIPPETS_ENABLED=false

# --- Instagram Business Discovery (off until Meta App Review passes) ---------------------------
INSTAGRAM_ENABLED=false
META_GRAPH_API_VERSION=v26.0
META_IG_USER_ID=
META_ACCESS_TOKEN=

# --- Janitor ------------------------------------------------------------------------------------
JANITOR_REMOVE_CLASSIFIED=false
JANITOR_CLASSIFICATION_RETENTION_DAYS=30
